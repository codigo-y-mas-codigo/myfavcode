#app
  .flex
    aside
      nav
        each _,i in Array(30)
          a(href="#") link #{i+1}
      
    fullscreen.fullscreen(
      :fullscreen.sync='fullscreen',
      :class="{full:fullscreen}"
      ref='fullscreen', 
      background='#FFF'
    )
      .btn.fill.red(
        :class="{'xl':fullscreen}"
        @click='toggleFullScreen'
      ) fullscreen
      .DIV
        table.table_distance.table_striped
          thead
            tr
              each _,i in Array(7)
                th thead_#{i+1}
          each _,x in Array(100)
            tr
              each _,i in Array(7)
                td data_#{x+1}.#{i+1}
