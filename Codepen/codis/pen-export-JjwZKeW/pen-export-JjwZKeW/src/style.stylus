.flex
  display flex
  aside
    width 200px 
    min-width 120px
    background #EEE
    padding 1em
    margin-right 1em
    nav
      position sticky
      top 1em
    a
      display block
      line-height 2


// thead tr:first-child th
thead th
  position sticky
  top 0
  background #FFF //rgba(#FFF, .5)
  //border-bottom 1px solid #000

.fullscreen
  position relative
  flex 1
  margin-right 1em
  &.full .btn
    position fixed
    left 4px
    top 4px
  .btn
    position absolute
    z-index 1
    left -5em
    font-weight bold



